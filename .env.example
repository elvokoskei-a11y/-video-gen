# ═══════════════════════════════════════════════════════════════════════════════
# Intelligent Video Clipper — Environment Variables
# Copy this file to .env.local for local development.
# Never commit real secrets. All server-side values stay on the server.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── AI Providers (SERVER-SIDE ONLY) ─────────────────────────────────────────

# Google Gemini — PRIMARY AI provider for video analysis
# Get your key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Additional Gemini API keys for increased capacity (optional)
# Supports multiple formats:
# 1. JSON array of strings: ["key1","key2","key3"]
# 2. JSON array with metadata: [{"key":"key1","label":"Production","projectId":"proj-1"}]
# 3. Comma-separated: key1,key2,key3
# 
# IMPORTANT: Keys from the same Google Cloud project share quotas.
# For true capacity increase, use keys from different projects.
# 
# Example with 5 keys (different projects for independent quotas):
# GEMINI_API_KEYS=["AIza...key1","AIza...key2","AIza...key3","AIza...key4","AIza...key5"]
GEMINI_API_KEYS=

# Gemini daily request budget (optional, prevents unexpected costs)
# Set to limit total requests per day. Default: unlimited
# GEMINI_DAILY_REQUEST_LIMIT=1000

# Maximum concurrent Gemini requests (optional)
# Default: 10. Increase cautiously to avoid rate limits.
# GEMINI_CONCURRENT_LIMIT=10

# NVIDIA API — FALLBACK AI provider (DeepSeek or other models)
# Get your key: https://build.nvidia.com/
NVIDIA_API_KEY=

# NVIDIA API Configuration
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=deepseek-ai/deepseek-r1

# Gemini Model Configuration
GEMINI_MODEL=gemini-1.5-pro

# ─── Automatic Failover Configuration ────────────────────────────────────────

# Primary provider (gemini recommended for video analysis)
AI_PRIMARY_PROVIDER=gemini

# Fallback provider (nvidia with DeepSeek for text-based analysis)
AI_FALLBACK_PROVIDER=nvidia

# Enable automatic failover on quota exhaustion or rate limits
AI_AUTO_FAILOVER=true

# Maximum retries per provider before failover
AI_MAX_RETRIES=2

# Request timeout in milliseconds
AI_PROVIDER_TIMEOUT_MS=60000

# ─── Supabase (SERVER-SIDE ONLY) ─────────────────────────────────────────────

# Your Supabase project URL
# Find in: Supabase dashboard → Settings → API
SUPABASE_URL=

# Service role key — server-side only, bypasses RLS
# Find in: Supabase dashboard → Settings → API → service_role
# NEVER expose this to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Anon (public) key — safe for client-side use
# Find in: Supabase dashboard → Settings → API → anon
SUPABASE_ANON_KEY=

# Direct database connection string (optional — Supabase client is preferred)
# DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# ─── Worker Configuration ─────────────────────────────────────────────────────

# Secret shared between Vercel and Railway worker for authenticated job claims
# Generate with: openssl rand -hex 32
WORKER_SECRET=

# Railway worker URL (used by Vercel to check worker health)
# RAILWAY_WORKER_URL=https://your-worker.railway.app

# ─── Feature Flags (optional) ────────────────────────────────────────────────
# ENABLE_WEB_RESEARCH=true
# ENABLE_HISTORICAL_LEARNING=true
# ENABLE_VISUAL_ANALYSIS=true
# ENABLE_SPEAKER_ANALYSIS=true

# ─── Clip Defaults (optional) ────────────────────────────────────────────────
# DEFAULT_CLIP_COUNT=7
# MIN_CLIP_DURATION=15
# MAX_CLIP_DURATION=90
# DEFAULT_PLATFORM=youtube_shorts

# ─── Authentication (Phase 2 — Optional) ──────────────────────────────────────
# Single-user password protection for private deployment
# Leave blank to disable authentication (public access)

# Application access password
# Choose a strong, unique password for production
# APP_ACCESS_PASSWORD=

# Session secret for signing cookies
# Generate with: openssl rand -hex 32
# MUST be set if APP_ACCESS_PASSWORD is set
# APP_SESSION_SECRET=

# Session expiry in days (default: 7)
# SESSION_EXPIRY_DAYS=7
